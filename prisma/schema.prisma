generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password_hash String
  phone        String?
  role         String   @default("USER")
  created_at   DateTime @default(now())
}
