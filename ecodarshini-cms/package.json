{
  "name": "ecodarshini-cms",
  "version": "1.0.0",
  "description": "Payload CMS for Ecodarshini product images",
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts nodemon",
    "build:payload": "payload build",
    "build:server": "tsc",
    "build": "npm run build:payload && npm run build:server",
    "serve": "node dist/server.js",
    "generate:types": "payload generate:types"
  },
  "dependencies": {
    "@payloadcms/bundler-webpack": "^1.0.7",
    "@payloadcms/db-mongodb": "^1.7.0",
    "@payloadcms/richtext-slate": "^1.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "payload": "^2.30.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
